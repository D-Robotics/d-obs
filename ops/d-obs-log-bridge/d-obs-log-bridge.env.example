# d-obs log bridge 环境样例；实际文件放 /etc/d-obs-log-bridge.env（0600）。
# token 明文在 /root/d-obs-rdkstudio-onboarding.md，可在工作台「接入凭据」轮换。
RDK_LOG_BRIDGE_ENDPOINT=http://127.0.0.1:18093
RDK_LOG_BRIDGE_TOKEN=<bearer token for service:rdkstudio-web>
RDK_LOG_BRIDGE_UNITS=rdstudio-web-opt,rdstudio-web-opt-standby,rdstudio-alert-worker,rdstudio-error-digest,rdstudio-otel-collector,rdstudio-otel-shadow-backend,rdstudio-skill-decision-worker,rdstudio-conversation-sync
RDK_LOG_BRIDGE_STATE_DIR=/var/lib/d-obs-log-bridge
RDK_LOG_BRIDGE_HOST=rdkstudio-prod
