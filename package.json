{
  "name": "rdk-d-obs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RDK observability platform — ops workbench, alerting, traces, model-pool control (extracted from RDK Studio per D-010)",
  "scripts": {
    "start": "tsx server/main.ts",
    "worker": "tsx server/monitoring/studio-alert-worker.ts",
    "worker:check-config": "tsx server/monitoring/studio-alert-worker.ts --check-config",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@supabase/supabase-js": "^2.100.1",
    "express": "^4.22.2",
    "undici": "7.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
